# Waits until the host's Valkey accepts connections, so a pod can start after it.
#
# Valkey is a system service and the pods are user services, and a user's units can't depend on
# system ones. So this user unit knocks on Valkey's port until it answers, and the pod starts
# after it (vivy.pod or plana.pod: Wants= and After=valkey-wait.service).
#
# A plain systemd unit, not a quadlet: install it with
#   install -Dm644 valkey-wait.service ~/.config/systemd/user/valkey-wait.service
#
# Gives up after TimeoutStartSec. The pod still starts then (Wants=, not Requires=): Plana runs
# without Redis and connects once it's up, Vivy exits and systemd restarts it until it can.

[Unit]
Description=Wait for the host's Valkey on 127.0.0.1:6379

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/bash -c 'until (: </dev/tcp/127.0.0.1/6379) 2>/dev/null; do sleep 1; done'
TimeoutStartSec=120

[Install]
WantedBy=default.target
